<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Notis Space theme</title>
  <!--
    Canonical CLI and SDK theme. Only the style block below is read: the CLI
    verification server serves it as /theme.css, and the view renderer build
    writes it to dist/theme.css, which the renderer digest covers. Keep its
    bytes stable. Nothing else in this file is served or copied into scaffolds.
  -->
  <style>
    /*
     * Portal-parity theme tokens. In production the portal copies its computed
     * :root custom properties onto the app root, so app CSS written against
     * hsl(var(--token)) resolves to the real portal palette. The harness mirrors
     * the portal's light theme here so dev renders and listing screenshots look
     * exactly like the app inside the portal. Keep in sync with
     * portal/src/app/globals.css (:root).
     */
    :root {
      color-scheme: light;
      --background: 0 0% 100%;
      --foreground: 222.2 84% 4.9%;
      --card: 0 0% 100%;
      --card-foreground: 222.2 84% 4.9%;
      --popover: 0 0% 100%;
      --popover-foreground: 222.2 84% 4.9%;
      --primary: 222.2 47.4% 11.2%;
      --primary-foreground: 210 40% 98%;
      --secondary: 210 40% 96.1%;
      --secondary-foreground: 222.2 47.4% 11.2%;
      --muted: 210 40% 96.1%;
      --muted-foreground: 0 0% 46.9%;
      --accent: 210 40% 96.1%;
      --accent-foreground: 222.2 47.4% 11.2%;
      --destructive: 0 84.2% 60.2%;
      --destructive-foreground: 210 40% 98%;
      --border: 214.3 31.8% 91.4%;
      --input: 214.3 31.8% 91.4%;
      --ring: 222.2 84% 4.9%;
      --radius: 0.5rem;
      --chart-1: 210 100% 49%;
      --chart-2: 173 58% 39%;
      --chart-3: 197 37% 24%;
      --chart-4: 43 74% 66%;
      --chart-5: 27 87% 67%;
    }
    :root.dark {
      color-scheme: dark;
      --background: 0 0% 13%;
      --foreground: 210 40% 98%;
      --card: 0 0% 13%;
      --card-foreground: 210 40% 98%;
      --popover: 0 0% 13%;
      --popover-foreground: 210 40% 98%;
      --primary: 210 40% 98%;
      --primary-foreground: 222.2 47.4% 11.2%;
      --secondary: 0 0% 18%;
      --secondary-foreground: 210 40% 98%;
      --muted: 0 0% 18%;
      --muted-foreground: 0 0% 65.1%;
      --accent: 0 0% 18%;
      --accent-foreground: 210 40% 98%;
      --destructive: 0 84.2% 60.2%;
      --destructive-foreground: 210 40% 98%;
      --border: 0 0% 23.5%;
      --input: 0 0% 23.5%;
      --ring: 212.7 26.8% 83.9%;
      --chart-1: 220 70% 50%;
      --chart-2: 160 60% 45%;
      --chart-3: 30 80% 55%;
      --chart-4: 280 65% 60%;
      --chart-5: 340 75% 55%;
    }
    body {
      margin: 0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: hsl(var(--background));
      color: hsl(var(--foreground));
      -webkit-font-smoothing: antialiased;
    }
    #root { min-height: 100vh; }
  </style>
</head>
<body></body>
</html>
