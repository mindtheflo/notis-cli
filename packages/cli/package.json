{
  "name": "@notis_ai/cli",
  "version": "0.2.0",
  "description": "Agent-first Notis CLI for apps and generic tool execution",
  "type": "module",
  "bin": {
    "notis": "bin/notis.js"
  },
  "files": [
    "bin/",
    "config/",
    "dist/",
    "src/",
    "skills/",
    "template/",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build-scaffolds.js",
    "docs:generate": "node ./scripts/generate-docs.js",
    "docs:check": "node ./scripts/generate-docs.js --check",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "release:prepare": "npm run build && node ./scripts/prepare-publish.js --apply",
    "smoke": "node ./scripts/smoke-package.js",
    "test": "node --test --test-timeout=120000",
    "preinstall": "node ./bin/check-runtime.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "notis",
    "cli",
    "ai",
    "agent-skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
